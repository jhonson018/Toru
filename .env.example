# Copia este archivo a .env y sustituye los dos valores.
# Supabase → Project Settings → API.
#
# EXPO_PUBLIC_SUPABASE_URL es la Project URL.
# EXPO_PUBLIC_SUPABASE_ANON_KEY es la clave pública.
# En proyectos nuevos puede llamarse "anon" o "publishable".
# Es la clave que puede ir dentro de la app.
#
# Nunca pongas aquí la clave service_role: esa ignora las reglas
# de seguridad y no debe salir del servidor.

EXPO_PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anon
